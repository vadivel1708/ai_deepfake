# ==========================================
# AI-Based Deepfake Detection & Media Authenticity System
# Environment Configuration Template
# ==========================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="AI-Based Deepfake Detection & Media Authenticity Analysis System"
VERSION=1.0.0

# Security & Secrets
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default (Zero installation required):
DATABASE_URL=sqlite:///./storage/deepfake_system.db
# For PostgreSQL in Production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deepshield_db

# File Ingestion & Restrictions
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB limit

# AI Pipeline Hyperparameters
VIDEO_FRAME_SAMPLE_RATE=10
VIDEO_MAX_FRAMES_TO_ANALYZE=60

# Frontend Environment Variables (Vite)
VITE_API_URL=http://localhost:8000/api
VITE_STORAGE_URL=http://localhost:8000
